SETTINGS_STORAGE_TYPE="env"

DB_PSQL_NAME="postgres"
DB_PSQL_ADDRESS="localhost"
DB_PSQL_USER="postgres"
DB_PSQL_PASS="test"
DB_PSQL_PORT="5432"

HTTP_ADDRESS="localhost"
HTTP_PORT="8088"
HTTP_GET_CREATURE_TYPES_ENDPOINT="/creatures_data/types"
HTTP_PUT_CREATURE_TYPES_ENDPOINT="/creatures_data/types"

CREATURE_TYPES_STORAGE_TYPE="postgres"

KAFKA_SERVERS="localhost:9092"
KAFKA_PRODUCE_TIMEOUT="2000µs"
KAFKA_UPDATE_CREATURE_TYPES_TOPIC="update_creature_types"
KAFKA_GET_CREATURE_TYPES_TOPIC="get_creature_types"
KAFKA_GET_CREATURE_TYPES_IS_GROUP_UNIQUE="false"
KAFKA_GET_CREATURE_TYPES_GROUP_ID="get_creature_types_group"
KAFKA_SEND_CREATURE_TYPES_TOPIC="get_creature_types_resp"

GLOBAL_ENV_TYPE="local"

ROUTER_TYPES="rest,grpc"

GIN_MODE="debug"

GRPC_ADDRESS="localhost:44044"
GRPC_NETWORK="tcp"

GRPC_CLIENT_TIMEOUT="2000µs"

REQUEST_TRACE_ID_FIELD="traceID"

PROMETHEUS_METRICS_ENDPOINT="/metrics"
