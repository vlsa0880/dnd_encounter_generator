SETTINGS_STORAGE_TYPE="env"

DB_PSQL_NAME="postgres"
DB_PSQL_ADDRESS="postgres"
DB_PSQL_USER="postgres"
DB_PSQL_PASS="test"
DB_PSQL_PORT="5432"

HTTP_ADDRESS="0.0.0.0"
HTTP_PORT="8088"
HTTP_GET_CREATURE_TYPES_ENDPOINT="/creatures_data/types"
HTTP_PUT_CREATURE_TYPES_ENDPOINT="/creatures_data/types"

CREATURE_TYPES_STORAGE_TYPE="redis_postgres"

REDIS_PASSWORD="test"
REDIS_CREATURE_TYPES_KEY="creature:types"
REDIS_CONNECT_ADDRESS="redis:6379"
REDIS_CONNECT_TIMEOUT="5s"
REDIS_UPDATE_TIMEOUT="5s"
REDIS_UPDATE_SLEEP="1s"

KAFKA_SERVERS="kafka:9092"
KAFKA_HANDLE_TIMEOUT="2000ms"
KAFKA_UPDATE_CREATURE_TYPES_TOPIC="update_creature_types"
KAFKA_GET_CREATURE_TYPES_TOPIC="get_creature_types"
KAFKA_GET_CREATURE_TYPES_IS_GROUP_UNIQUE="false"
KAFKA_GET_CREATURE_TYPES_GROUP_ID="get_creature_types_group"
KAFKA_SEND_CREATURE_TYPES_TOPIC="get_creature_types_resp"
KAFKA_EXTERNAL_SERVERS="0.0.0.0:9093"
KAFKA_LOG_TOPIC="logging"
KAFKA_AUTO_TOPICS_CREATION="true"
KAFKA_AUTO_TOPICS_CREATION_TIMEOUT="15000ms"

GLOBAL_ENV_TYPE="Dev"

ROUTER_TYPES="rest,grpc,kafka"

GIN_MODE="debug"

GRPC_ADDRESS="0.0.0.0:44044"
GRPC_NETWORK="tcp"

GRPC_CLIENT_TIMEOUT="2000ms"

REQUEST_TRACE_ID_FIELD="traceID"

PROMETHEUS_METRICS_ENDPOINT="/metrics"
